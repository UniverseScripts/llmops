{
  "title": "Phase 5: Edge Node Telemetry",
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "title": "B2B Edge Ingress (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (http_status) (rate(llmops_request_total[1m]))",
          "legendFormat": "HTTP {{http_status}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "p95 Inference Latency",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(llmops_request_latency_seconds_bucket[1m])))",
          "legendFormat": "{{endpoint}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ],
  "schemaVersion": 38
}